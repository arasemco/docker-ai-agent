# =============================================================================
# Example: routing the container through an HTTP proxy
# =============================================================================
# These are EXAMPLE values, not defaults — the compose file ships with empty
# proxy variables. If a single proxy serves every scheme, one PROXY=... line is
# enough (the anchor resolves HTTP_PROXY -> http_proxy -> PROXY -> empty); the
# per-variable form below overrides it scheme by scheme. Use whichever fits.
#
#   cp .env.example .env
#   cat examples/env/proxy.env >> .env             # merge into your .env
#
# or keep it separate and point compose at it:
#
#   docker compose --env-file examples/env/proxy.env \
#                  --profile opencode up -d --build
#
# Notes:
#   * NO_PROXY must list the hosts the container reaches directly. A Docker
#     daemon inside the container also inherits these values, so anything it
#     pulls goes through the same proxy.
#   * Both cases (upper- and lowercase) are set because tools disagree about
#     which one they honour.
#   * An empty value in .env disables that variable: compose passes it through
#     as empty, not as "no proxy defined".
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48
