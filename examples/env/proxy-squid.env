# =============================================================================
# Example: routing the container through an HTTP proxy (Squid)
# =============================================================================
# EXAMPLE values, not defaults — the stack ships with proxy pass-throughs that
# stay empty. Merge into your .env or pass with --env-file:
#
#   cp .env.example .env && cat examples/env/proxy-squid.env >> .env
#   docker compose --env-file examples/env/proxy-squid.env up -d
#
# NO_PROXY must list whatever the container reaches directly (loopback, any
# local model endpoint). Both cases are set because tools disagree about which
# one they honour.
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48
