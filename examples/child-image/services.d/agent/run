#!/command/with-contenv bash
# =============================================================================
# services.d/agent/run — example launch line
#
# Replaces agent-base's run script. The executable comes first; every argument
# after it reaches the CLI unchanged (hooks may append flags). Keep it to one
# exec of agent-service-start so the daemon wait, privilege drop and restart
# policy from the base image still apply.
# =============================================================================
set -euo pipefail

exec /usr/local/bin/agent-service-start example-cli
