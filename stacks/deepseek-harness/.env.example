# dsh environment.
#
# Copy to .env (gitignored) for local overrides; every value here is the default
# and none is required. Deployment-specific values (proxy URLs, host paths,
# limits) live in examples/ on purpose.
#
#   cp .env.example .env

# Build args
# Shared base image this Dockerfile builds FROM. Pin a tag (never :latest) so a
# rebuild is reproducible; add a registry prefix to use a pushed agent-base.
AGENT_BASE=agent-base:1.4.1
DSH_IMAGE=dsh:local
# Exact @deepseek-ai/dsh version from npm.
DSH_VERSION=0.2.1-rc.5
# Runtime
# dsh binds loopback only; the compose file uses host networking so the UI
# answers at http://localhost:3080. DSH_PORT is the port it listens on.
DSH_PORT=3080
# 0 skips starting the inner Docker daemon (the agent still works).
DSH_DOCKERD=1
# Extra browser-trust authorities for /api, space separated (usually empty).
DSH_TRUSTED_HOSTS=

# Shared sandbox (agent-base compose fragments)
AGENT_DOCKERD=1
AGENT_DOCKER_VOLUME=agent-docker
# Used by the limits fragment; uncomment to override its defaults (2 / 4G).
# AGENT_CPUS=2
# AGENT_MEMORY=4G
# Used by the mounts and skills fragments.
# AGENT_WORKSPACE_HOST=./workspace
# AGENT_SKILLS_HOST=./skills

# Persistent storage. Profiles, credentials and session history; a named volume
# by default, or a host path owned by uid 1000.
DSH_HOME_HOST=dsh-home

# Outbound proxy (read only by the proxy fragment). PROXY is one value for every
# scheme; a per-scheme variable wins over it. See examples/env/proxy.env.
PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
all_proxy=
no_proxy=
