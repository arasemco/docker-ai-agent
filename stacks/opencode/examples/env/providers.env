# =============================================================================
# Example: provider credentials and a local model endpoint
# =============================================================================
# Copy the lines you need into .env (gitignored). Anything left unset simply
# isn't offered by the UI.
#
# A local OpenAI-compatible server (Ollama, vLLM, LM Studio, …): see
# ../config/opencode.jsonc for how the provider entry reads these.
OLLAMA_BASE_URL=http://192.168.1.48:11434/v1
OLLAMA_API_KEY=ollama

# Hosted providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Any other provider key your fork of the config uses, e.g.
# MAMMOUTH_API_KEY=
