# =============================================================================
# Example: routing the container through an HTTP proxy
# =============================================================================
# Example values, not defaults: the stack ships with empty proxy pass-throughs.
# A single PROXY=... line covers every scheme (the shared x-agent-env anchor
# resolves HTTP_PROXY -> http_proxy -> PROXY -> empty); the per-variable form
# below overrides it scheme by scheme.
#
# Merge into .env, or pass the file to compose:
#
#   cat examples/env/proxy.env >> .env
#   docker compose --env-file examples/env/proxy.env up -d
#
# NO_PROXY must list whatever the container reaches directly (loopback, a local
# model endpoint). Both cases are set because tools disagree about which one they
# honour.
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48
