{
  "$schema": "https://opencode.ai/config.json",
  // Ollama exposes an OpenAI-compatible API. Override the endpoint/key with
  // OLLAMA_BASE_URL and OLLAMA_API_KEY if the server moves.
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B (Ollama)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 16384 }
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (Ollama)",
          "tool_call": true,
          "reasoning": true,
