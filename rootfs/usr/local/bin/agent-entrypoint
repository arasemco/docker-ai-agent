#!/bin/bash
# =============================================================================
# agent-entrypoint — the image's ENTRYPOINT. Runs only briefly.
#
# s6-overlay's /init is PID 1 and supervises the real services:
#   /etc/services.d/dockerd  the rootless Docker daemon (as AGENT_USER)
#   /etc/services.d/agent    the agent CLI itself (as AGENT_USER)
#
# s6 does not forward the docker CMD args to services, so this wrapper stashes
# them NUL-separated in /run/agent/args and hands PID 1 over to /init. The
# agent service reads the file back (services.d/agent/run → agent-run), so
# `docker compose run opencode web --port 4096` still reaches the CLI exactly
# as before. An empty CMD leaves the file empty and the CLI runs with no args.
# =============================================================================
set -e

mkdir -p /run/agent
chmod 0755 /run/agent

if [ "$#" -eq 0 ]; then
    : > /run/agent/args
else
    printf '%s\0' "$@" > /run/agent/args
fi
chmod 0644 /run/agent/args

exec /init
