#!/command/with-contenv bash
# =============================================================================
# services.d/dockerd/finish — runs after services.d/dockerd/run exits.
#
# s6 restarts a longrun that exits, which is what we want for a crashed
# daemon — but not for one this host simply cannot start (e.g. a host whose
# own Docker is rootless refuses the nested user namespace). So:
#
#   * a daemon that ran for at least 60s resets the failure counter (a crash
#     after a long uptime is not a startup problem);
#   * a shorter-lived one counts as a failed start, and after
#     AGENT_DOCKERD_MAX_RESTARTS of those the run script idles instead of
#     retrying (see its `idle` helper).
#
# The idle path leaves /run/agent/dockerd.idle behind; a service that was
# deliberately idling must not be counted as a failure when the container
# stops.
# =============================================================================
set -uo pipefail

export AGENT_LOG_TAG=dockerd
# shellcheck source=/dev/null
. /usr/local/lib/agent-base/lib.sh

rc="${1:-?}"

if [ -f /run/agent/dockerd.idle ]; then
    exit 0
fi
if [ "${AGENT_DOCKERD:-1}" = "0" ]; then
    exit 0
fi

now="$(date +%s)"
started="$(cat /run/agent/dockerd.started 2>/dev/null || echo 0)"
uptime=$(( now - started ))

if [ "${uptime}" -ge 60 ]; then
    rm -f /run/agent/dockerd.fails
    log "exited with status ${rc} after ${uptime}s; restarting (failure counter reset)"
    exit 0
fi

fails="$(cat /run/agent/dockerd.fails 2>/dev/null || echo 0)"
fails=$(( fails + 1 ))
printf '%s\n' "${fails}" > /run/agent/dockerd.fails 2>/dev/null || true
log "exited with status ${rc} after ${uptime}s (failed start ${fails} of ${AGENT_DOCKERD_MAX_RESTARTS:-3})"
