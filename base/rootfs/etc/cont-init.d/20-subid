#!/command/with-contenv bash
# =============================================================================
# cont-init.d/20-subid — adapts the subordinate id ranges for the inner rootless
# daemon. Rootless hosts cannot reach the default 100000:65536 range; rewrite
# the ranges into ids this container can actually map. AGENT_SUBID_REMAP=0
# disables the rewrite.
# =============================================================================
set -euo pipefail

# shellcheck source=/dev/null
. /usr/local/lib/agent-base/lib.sh

AGENT_USER="${AGENT_USER:-agent}"
uid="$(agent_uid)"
gid="$(agent_gid)"

rewrite_subid_range() {
    local map_file="$1" subid_file="$2" own_id="$3" user="$4"
    local max start count last

    [ "${AGENT_SUBID_REMAP:-1}" = "0" ] && return 0
    [ -r "${map_file}" ] && [ -w "${subid_file}" ] || return 0

    max="$(awk '{ if ($1 + $3 - 1 > m) m = $1 + $3 - 1 } END { print m + 0 }' "${map_file}")"
    [ "${max}" -gt 1 ] || return 0

    start=""
    count=""
    read -r start count <<<"$(awk -F: -v u="${user}" '$1 == u { print $2, $3; exit }' "${subid_file}")" || true
    if [ -n "${start}" ] && [ "${start}" -ge 1 ]; then
        last=$(( start + count - 1 ))
        if [ "${last}" -le "${max}" ] && { [ "${last}" -lt "${own_id}" ] || [ "${start}" -gt "${own_id}" ]; }; then
            return 0
        fi
    fi

    {
        if [ "${own_id}" -gt 1 ]; then
            printf '%s:1:%s\n' "${user}" "$(( own_id - 1 ))"
        fi
        if [ "${max}" -gt "${own_id}" ]; then
            printf '%s:%s:%s\n' "${user}" "$(( own_id + 1 ))" "$(( max - own_id ))"
        fi
        awk -F: -v u="${user}" '$1 != u' "${subid_file}" 2>/dev/null || true
    } > "${subid_file}.tmp"
    mv "${subid_file}.tmp" "${subid_file}"

    log "rewrote ${subid_file} for ${user} into the reachable id range 1..${max}"
}

rewrite_subid_range /proc/self/uid_map /etc/subuid "${uid}" "${AGENT_USER}"
rewrite_subid_range /proc/self/gid_map /etc/subgid "${gid}" "${AGENT_USER}"
