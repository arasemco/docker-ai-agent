#!/bin/bash
# =============================================================================
# agent-entrypoint — the image's ENTRYPOINT. Runs only briefly.
#
# s6-overlay's /init is PID 1 and supervises the real services:
#   /etc/services.d/dockerd  the rootless Docker daemon (as AGENT_USER)
#   /etc/services.d/agent    the agent CLI itself (as AGENT_USER)
#
# s6 does not forward the docker CMD to services. This wrapper stores the
# arguments NUL-separated in /run/agent/args and hands PID 1 to /init; the agent
# service reads them back (services.d/agent/run -> agent-run), so
# `docker compose run myagent web --port 4096` reaches the CLI unchanged. An
# empty CMD leaves an empty file and the CLI runs with no arguments.
# =============================================================================
set -e

mkdir -p /run/agent
chmod 0755 /run/agent

if [ "$#" -eq 0 ]; then
    : > /run/agent/args
else
    printf '%s\0' "$@" > /run/agent/args
fi
chmod 0644 /run/agent/args

exec /init
