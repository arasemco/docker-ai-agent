#!/bin/bash
# =============================================================================
# agent-run — runs the s6 agent service's launch line as the agent user.
# Executed by agent-service-start (never by root), after the daemon wait.
#
#   "$@"              the image's launch line, from services.d/agent/run:
#                     the executable followed by its arguments, e.g.
#                     `opencode web --port 4096` or `dsh web`
#   AGENT_WORKSPACE   working directory (image ENV: $HOME/workspace)
#
# The first argument is executed; the rest are its arguments. Hooks in
# /etc/agent-entrypoint.d/*.sh are sourced here, as the agent user and in the
# workspace, after the executable has been split off, so they rewrite the
# arguments the CLI receives (`set -- web --no-open "$@"`).
# =============================================================================
set -e

if [ "$#" -eq 0 ]; then
    printf '[agent] %s ERROR: no launch line; services.d/agent/run must name a command\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
    exit 2
fi

: "${AGENT_WORKSPACE:=$HOME/workspace}"

cd "$AGENT_WORKSPACE"

cmd="$1"
shift

shopt -s nullglob
for hook in /etc/agent-entrypoint.d/*.sh; do
    printf '[agent] %s sourcing hook %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$hook" >&2
    # shellcheck disable=SC1090 # path is discovered at runtime by design
    . "$hook"
done
shopt -u nullglob

printf '[agent] %s handing off to: %s %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$cmd" "$*" >&2

exec "$cmd" "$@"
