#!/command/with-contenv bash
# =============================================================================
# services.d/agent/run — the agent CLI, as AGENT_USER.
#
# The base image has no CLI, so its launch line is the idle helper; a stack
# image replaces this script with one that names its CLI, for example:
#
#     exec /usr/local/bin/agent-service-start opencode web --port 4096
#
# agent-service-start waits for dockerd, drops to the agent user and hands the
# line to agent-run, which sources hooks and execs it. s6 supervises the
# process; nothing outside the image decides what runs.
# =============================================================================
set -euo pipefail

exec /usr/local/bin/agent-service-start /usr/local/bin/agent-idle
