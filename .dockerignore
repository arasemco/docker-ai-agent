# The build context is the Dockerfile plus rootfs/ only. Everything else in
# this directory is tooling for the host, so keep it out of the context (and
# out of the cache key).
.git
.gitignore
.dockerignore
.env
.env.local
.idea
data/
scripts/
.github/
*.md
compose.base.yml
docker-compose.yml
docker-bake.hcl
bake.sh
makefile
