# opencode container environment — GENERIC DEFAULTS ONLY.
#
# Copy to .env (gitignored) and adjust. Nothing here is required. Host-specific
# values (proxy URLs, absolute paths, limits) deliberately live in examples/ —
# see README.md#overrides.
#
#   cp .env.example .env

# Build args
# Shared base image the Dockerfile builds FROM. Pin a tag (never :latest) so a
# rebuild is reproducible; add a registry prefix to use a pushed agent-base.
AGENT_BASE=agent-base:1.1.0
OPENCODE_IMAGE=opencode:local
OPENCODE_VERSION=1.19.5

# Runtime
OPENCODE_PORT=4096
# Interface the Web UI is published on. Loopback by default, because the
# password below has a weak fallback; 0.0.0.0 exposes it to the LAN.
OPENCODE_BIND_IP=127.0.0.1
# HTTP basic auth password for the Web UI. Change it before publishing.
OPENCODE_SERVER_PASSWORD=changeme123

# Provider credentials — set only the ones you use (see examples/env/).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# A local OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, …)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Shared sandbox settings (agent-base/compose/base.yml)
AGENT_DOCKERD=1
AGENT_DOCKER_VOLUME=agent-docker

# Persistent storage (Docker-managed volumes by default; a host path binds)
OPENCODE_CONFIG_HOST=opencode-config
OPENCODE_DATA_HOST=opencode-data
OPENCODE_STATE_HOST=opencode-state

# Outbound proxy. Leave empty unless your network needs one — see
# examples/env/proxy-squid.env for the shape.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
all_proxy=
no_proxy=
