# OpenCode container environment
# Copy to .env and adjust as needed: cp .env.example .env

# Build args
OPENCODE_UID=1000
OPENCODE_GID=1000
OPENCODE_VERSION=1.19.5
DOCKER_VERSION=29.8.1

# Runtime
OPENCODE_SERVER_PASSWORD=changeme123
OPENCODE_PORT=4096

# Provider keys
MAMMOUTH_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Ollama server
OLLAMA_BASE_URL=http://192.168.1.48:11434/v1
OLLAMA_API_KEY=ollama

# Squid proxy (leave empty to disable)
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48

# Persistent storage (Docker-managed volumes by default)
OPENCODE_CONFIG_HOST=opencode-config
OPENCODE_DATA_HOST=opencode-data
OPENCODE_STATE_HOST=opencode-state
