# agent-base environment
# Copy to .env and adjust as needed: cp .env.example .env
#
# Child stacks (claude-code, opencode, deepseek-harness) inherit this file's
# variable names; AGENT_USER is what maps their renamed account onto the mount
# paths in compose.base.yml (e.g. AGENT_USER=dsh).

# Build args
AGENT_USER=agent
AGENT_UID=1000
AGENT_GID=1000
DOCKER_VERSION=29.8.1
UV_VERSION=0.13.6

# Runtime
AGENT_IMAGE=agent-base:local
AGENT_HOSTNAME=agent-base
AGENT_DOCKERD=1

# Persistent storage
# Named Docker volume (declared in docker-compose.yml) holding the in-container
# rootless daemon's images and build cache. Set an absolute host path to use a
# bind mount instead.
AGENT_DOCKER_VOLUME=agent-docker
# Host directory mounted as the agent's working directory (~/Projects in the
# container). Must exist and be writable by AGENT_UID.
AGENT_PROJECTS_HOST=

# Squid proxy (leave a value empty to disable that proxy)
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48
