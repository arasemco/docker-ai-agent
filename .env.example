# opencode container environment
# Copy to .env and adjust as needed: cp .env.example .env

# Build args
# Shared base image this Dockerfile builds FROM. Pin a tag (not :latest) so a
# rebuild is reproducible; bump it deliberately.
AGENT_BASE=git.omesa.net/asemo/agent-base:1.0.0
OPENCODE_IMAGE=opencode:local
OPENCODE_VERSION=1.19.5

# Runtime
OPENCODE_PORT=4096
# Interface the Web UI is published on. Loopback by default, because the
# server password has a weak fallback below; 0.0.0.0 exposes it to the LAN.
OPENCODE_BIND_IP=127.0.0.1
# HTTP basic auth password for the Web UI. Change it before publishing.
OPENCODE_SERVER_PASSWORD=changeme123

# Provider keys (leave empty to not offer that provider)
MAMMOUTH_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local Ollama server (see opencode.jsonc)
OLLAMA_BASE_URL=http://192.168.1.48:11434/v1
OLLAMA_API_KEY=ollama

# Shared sandbox settings (agent-base/compose.base.yml)
AGENT_DOCKERD=1
AGENT_DOCKER_VOLUME=agent-docker
# Host directory mounted as the agent's working directory. Empty means
# ${HOME}/Projects.
AGENT_PROJECTS_HOST=

# Squid proxy (leave a value empty to disable that proxy)
HTTP_PROXY=http://192.168.1.48:3128
HTTPS_PROXY=http://192.168.1.48:3128
ALL_PROXY=http://192.168.1.48:3128
NO_PROXY=localhost,127.0.0.1,::1,192.168.1.48
http_proxy=http://192.168.1.48:3128
https_proxy=http://192.168.1.48:3128
all_proxy=http://192.168.1.48:3128
no_proxy=localhost,127.0.0.1,::1,192.168.1.48

# Persistent storage (Docker-managed volumes by default)
OPENCODE_CONFIG_HOST=opencode-config
OPENCODE_DATA_HOST=opencode-data
OPENCODE_STATE_HOST=opencode-state
