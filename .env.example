# agent-base environment — GENERIC DEFAULTS ONLY.
#
# Copy to .env (gitignored) for local overrides. Nothing here is required: the
# image and compose files work with every value unset. Host-specific values
# (proxy URLs, absolute paths, resource limits) deliberately do not live in
# this file — see examples/env/ and README.md#overrides.
#
#   cp .env.example .env

# Build args
AGENT_USER=agent
AGENT_UID=1000
AGENT_GID=1000
DOCKER_VERSION=29.8.1
UV_VERSION=0.13.6

# Runtime
AGENT_IMAGE=agent-base:local
AGENT_HOSTNAME=agent
AGENT_DOCKERD=1
# Consecutive failed starts before a service is left down instead of restarted
# (delete /run/agent/*.fails inside the container to retry).
AGENT_DOCKERD_MAX_RESTARTS=3
AGENT_RESTART_MAX=3

# Persistent storage. Named Docker volume for the in-container daemon's images
# and build cache; set an absolute host path to bind instead.
AGENT_DOCKER_VOLUME=agent-docker

# Compose fragments (see compose/ and README#compose-fragments). Uncomment the
# ones you select with WITH=...; the values in brackets are the defaults.
# AGENT_CPUS=2                 # limits fragment
# AGENT_MEMORY=4G              # limits fragment
# AGENT_WORKSPACE_HOST=./workspace   # mounts fragment

# Outbound proxy (read only by the `proxy` fragment). Leave empty unless your
# network requires one. PROXY is one value for every scheme; a per-scheme
# variable wins over it, and either case of a variable fills the other.
# examples/env/proxy.env shows the per-variable shape.
PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
all_proxy=
no_proxy=
