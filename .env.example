# opencode environment.
#
# Copy to .env (gitignored) for local overrides; every value here is the default
# and none is required. Deployment-specific values (proxy URLs, host paths,
# limits) are kept out of this file on purpose: see examples/ and
# agent-base's docs/configuration.md.
#
#   cp .env.example .env

# Build args
# Shared base image this Dockerfile builds FROM. Pin a tag (never :latest) so a
# rebuild is reproducible; add a registry prefix to use a pushed agent-base.
AGENT_BASE=agent-base:1.4.0
OPENCODE_IMAGE=opencode:local
OPENCODE_VERSION=1.19.5

# Runtime
OPENCODE_PORT=4096
# Interface the Web UI is published on. Loopback by default, because the
# password below has a weak fallback; 0.0.0.0 exposes it to the LAN.
OPENCODE_BIND_IP=127.0.0.1
# HTTP basic auth password for the Web UI. Change it before publishing.
OPENCODE_SERVER_PASSWORD=changeme123

# Provider credentials — set only the ones in use (see examples/env/providers.env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# A local OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, …)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Shared sandbox (agent-base compose fragments)
AGENT_DOCKERD=1
AGENT_DOCKER_VOLUME=agent-docker
# Used by the limits fragment; uncomment to override its defaults (2 / 4G).
# AGENT_CPUS=2
# AGENT_MEMORY=4G
# Used by the mounts and skills fragments.
# AGENT_WORKSPACE_HOST=./workspace
# AGENT_SKILLS_HOST=./skills

# Persistent storage (Docker-managed volumes by default; a host path binds)
OPENCODE_CONFIG_HOST=opencode-config
OPENCODE_DATA_HOST=opencode-data
OPENCODE_STATE_HOST=opencode-state

# Outbound proxy (read only by the proxy fragment). PROXY is one value for every
# scheme; a per-scheme variable wins over it. See examples/env/proxy.env.
PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
all_proxy=
no_proxy=
