# ai/agent environment.
#
# Copy to .env (gitignored) for local overrides; every value here is the default
# and none is required. Deployment-specific values (proxy URLs, host paths,
# limits) live in examples/ on purpose.
#
#   cp .env.example .env

# --- Base image -------------------------------------------------------------
AGENT_USER=agent
AGENT_UID=1000
AGENT_GID=1000
DOCKER_VERSION=29.8.1
UV_VERSION=0.13.6
AGENT_BASE=agent-base:1.4.1

# Sandbox knobs (compose/base.yml, daemon.yml and the opt-in fragments)
AGENT_DOCKERD=1
AGENT_DOCKERD_TIMEOUT=30
AGENT_DOCKERD_MAX_RESTARTS=3
AGENT_RESTART_MAX=3
AGENT_DOCKER_VOLUME=agent-docker
AGENT_HOSTNAME=agent
# limits fragment
AGENT_CPUS=2
AGENT_MEMORY=4G
# mounts fragment (default ./workspace next to this file)
AGENT_WORKSPACE_HOST=
# skills fragment (default ./skills next to this file)
AGENT_SKILLS_HOST=

# --- opencode stack ---------------------------------------------------------
OPENCODE_IMAGE=opencode:local
OPENCODE_VERSION=1.19.5
OPENCODE_PORT=4096
OPENCODE_BIND_IP=127.0.0.1
OPENCODE_SERVER_PASSWORD=changeme123
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OPENCODE_CONFIG_HOST=opencode-config
OPENCODE_DATA_HOST=opencode-data
OPENCODE_STATE_HOST=opencode-state

# --- dsh (DeepSeek Harness) stack -------------------------------------------
DSH_IMAGE=dsh:local
DSH_VERSION=0.2.1-rc.5
DSH_PORT=3080
DSH_DOCKERD=1
DSH_TRUSTED_HOSTS=
DSH_HOME_HOST=dsh-home

# --- Outbound proxy (read only by the proxy fragment) -----------------------
# PROXY is one value for every scheme; a per-scheme variable wins over it.
PROXY=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
all_proxy=
no_proxy=
